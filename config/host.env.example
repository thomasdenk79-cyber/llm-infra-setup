# Copy to host.env and keep secrets outside Git.
LLM_MODELS_DIR=${HOME}/models
LLM_CACHE_DIR=${HOME}/.local/share/llm-infra/cache
LLM_NIXL_DIR=${HOME}/.local/share/llm-infra/nixl
PENNYROYAL_PORT=8001
# Host RAM HiCache tier in decimal GB. WSL's configured cap will be 170 GB.
PENNY_HICACHE_SIZE_GB=8
PENNY_PLE_BACKEND=ram
PENNY_PLE_NVME_MODEL=${HOME}/.local/share/llm-infra/ple/Qwen3.8-Flash-Next-PLE-NVME
PLE_STORAGE_IMAGE=${HOME}/.local/share/llm-infra/ple-nvme.ext4
PLE_STORAGE_MOUNT=${HOME}/.local/share/llm-infra/ple-ext4
PLE_STORAGE_SIZE_GB=110
LITELLM_PORT=4000
# ZFS is not used by this CachyOS WSL2 deployment.

PENNY_SECURITY_OPT=seccomp=unconfined  # SSD reader io_uring compatibility

# --- Aufnahmefaehigkeit und Schreibrate --------------------------------------
# Diese Werte gehen als Umgebungsvariablen in die Runtime-Unit (siehe
# scripts/50-install-pennyroyal.sh). Leer lassen = Defaults des Bildes.
# Maximal aufgenommene Anfragen (Bild-Standard 4). erhoehen bringt Gesamtdurchsatz,
# senkt aber die Rate pro Anfrage.
PENNY_MAX_RUNNING_REQUESTS=
# Plaetze fuer wiederkehrenden Zustand (Bild-Standard 24). Muss groesser sein als
# PENNY_MAX_RUNNING_REQUESTS.
PENNY_MAX_MAMBA_CACHE_SIZE=
# Explizite Obergrenze fuer den KV-Zeichenspeicher; leer = SGLang auto-sizing.
# Ein expliziter Wert kostet VRAM und begrenzt die Kapazitaet.
PENNY_MAX_TOTAL_TOKENS=
# Vorhersagende Ausfuehrung (Standard 3/1/4) und Leerlaufpause (1 = an).
PENNY_SPEC_NUM_STEPS=3
PENNY_SPEC_EAGLE_TOPK=1
PENNY_SPEC_NUM_DRAFT_TOKENS=4
PENNY_SLEEP_ON_IDLE=1
PENNY_MEM_FRACTION_STATIC=0.981
# Online-FP8 fuer die dichten Projektionen (Experten bleiben NVFP4). false = aus.
# Umschalten leert den NIXL-Zeichenspeicher-Cache (neuer Start dauerts laenger).
PENNY_ONLINE_FP8=false
# Kleinere mitgezeichnete Batchgroessen geben Speicher fuer den Zeichenspeicher frei.
# Fuer exakte Decode-Graphen eine aufsteigende, kommagetrennte Liste verwenden.
# PENNY_CUDA_GRAPH_BS_DECODE=1,2,4,6,8
# Alternativ eine Obergrenze setzen; nicht zusammen mit der Liste verwenden.
# PENNY_CUDA_GRAPH_MAX_BS=2
# WSL/WDDM: TorchMemorySaver cu_mem_set_access is not supported on this driver path.
PENNY_ENABLE_MEMORY_SAVER=0
PENNY_CHUNKED_PREFILL_SIZE=4096
# SGLang default is 16384; keep >= PENNY_CHUNKED_PREFILL_SIZE.
# PENNY_MAX_PREFILL_TOKENS=32768
PENNY_GPU_UUID=GPU-780d3589-9811-40ec-db66-93a9146697f3
# WSL CUDA/NCCL fails with expandable allocator segments on this driver path.
PENNY_USE_EXPANDABLE_SEGMENTS=0
# Conservative defaults bound model-loader and CPU worker parallelism.
PENNY_LOADER_THREADS=4
PENNY_BUILD_JOBS=4
PENNY_TORCH_COMPILE_THREADS=4
PENNY_OMP_THREADS=4
PENNY_CDI_DEVICE=nvidia.com/gpu=all
# Native Blockflaeche fuer die Einbettungstabellen (siehe docs/performance.md):
# PENNY_PLE_NVME_MODEL=/srv/llm/ple-native/Qwen3.8-Flash-Next-PLE-NVME

# Optionaler lokaler Fallback (leer gelassen = Einzeldeployment wie bisher)
# FALLBACK_LITELLM_MODEL=openai/bonsai-2-27b
# FALLBACK_API_BASE=http://bonsai:8082/v1
# FALLBACK_MODEL_NAME=bonsai-2-27b
# FALLBACK_API_KEY (in gateway.env; llama-server prueft ihn nicht)
