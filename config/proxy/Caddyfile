# GENERIERT von scripts/74-setup-local-proxy.sh aus dieser Vorlage - aendern nur in
# config/proxy/Caddyfile.template, nie im gerendeten config/proxy/Caddyfile.
# Vorlage: config/proxy/Caddyfile.template. Ausgerollt wird die eingesetzte
# Fassung nach config/proxy/Caddyfile; gerendert und gerollt wird nur ueber
# den Generator (caddy validate laeuft vor dem Ausrollen).
#
# Lokaler HTTPS-Zugang ueber Namen, veroeffentlicht auf 127.0.0.1:443 und - wenn
# config/host.env LAN_BIND_IPS setzt - zusaetzlich auf den LAN-Adressen:
#   https://homepage.localhost/            -> Portal   (Container llm-homepage, intern 3000)
#   https://grafana.localhost/grafana/     -> Grafana  (Netzalias grafana,   intern 3000)
#   https://<name>.<LAN_DOMAIN>/           -> Portal, Grafana, Gateway, Logs, vLLM direkt
#
# Warum Container-Namen statt 127.0.0.1: rootless pasta reicht die Host-Loopback
# nicht an Container durch. Der Proxy haengt deshalb in den Netzen
# llm-observability (und bei LAN llm-inference) und proxen gegen die Namen, die
# dort aufloesen (gemessen: getent hosts grafana -> 10.89.1.x, litellm nur in
# llm-inference, die Runtime ueber den Weiterleiter auf dem Host).
#
# Schutz im LAN: LiteLLM verlangt seinen eigenen Schluessel (401 ohne); Dozzle,
# Grafana und direct-llm haben keine Proxy-Anmeldung und sind nur auf den
# explizit konfigurierten LAN-Adressen erreichbar. Prometheus, Alertmanager,
# Loki, Dozzle- und Gateway-Port bleiben auf Loopback. Der getrennte
# vLLM-Weiterleiter 30001 ist ebenfalls ohne Authentifizierung (docs/runtime.md).
#
# Zertifikate: Caddy-eigene lokale CA ("tls internal"), Bestand unter
# ~/.local/share/llm-infra/caddy/data. Ohne Verankerung im Systemtrust
# zeigen Browser und curl Warnungen; dagegen hilft:
#   ./scripts/74-setup-local-proxy.sh --ca-import      (dieser Rechner)
#   ./scripts/74-setup-local-proxy.sh --ca-export      (Windows-PC, docs/operations.md)
#
# Einsatzwerte des Generators (in dieser Vorlage stehen Platzhalter): Portal
# llm-homepage:3000, Grafana grafana:3000, Dozzle dozzle:8080, Gateway
# litellm:4000, vLLM ueber den Weiterleiter host.containers.internal:30001,
# LAN-Namen auf den Rechnernamen. Der LAN-Abschnitt kommt als Ganzer dazu und
# faellt vollstaendig weg, wenn LAN_BIND_IPS in config/host.env leer ist -
# deshalb ist diese Datei ohne LAN frei von jedem Zugang ins Netz.
{
	# Admin-API bewusst auf Loopback im Container: nicht veroeffentlicht, von
	# aussen nicht erreichbar; erlaubt aber schonendes Reload ohne Aussenport.
	admin 127.0.0.1:2019
}

homepage.localhost {
	tls internal
	encode zstd gzip
	header {
		defer
		delete X-Powered-By
		Strict-Transport-Security "max-age=31536000"
	}

	# Betreiber- und Nutzeranleitung vom Repo (config/proxy/site, siehe
	# scripts/74-setup-local-proxy.sh als Bind). Beide Blenden schliessen einander
	# aus, damit die statische Seite nicht zusaetzlich ans Portal weitergereicht
	# wird. /anleitung ohne Schraegstrich leitet Caddy selbst auf /anleitung/ um.
	handle /anleitung* {
		root * /srv/llm-proxy/site
		file_server
	}

	handle {
		reverse_proxy llm-homepage:3000
	}
}

grafana.localhost {
	# Grafana bedient weiter den Unterpfad /grafana/ (GF_SERVER_SERVE_FROM_SUB_PATH=true),
	# der Pfad wird unveraendert durchgereicht. Der Host bleibt grafana.localhost und
	# passt damit zu GF_SERVER_ROOT_URL=https://grafana.localhost/grafana/ in
	# ~/.config/llm-infra/grafana.env (Generator scripts/60-install-monitoring.sh).
	tls internal
	encode zstd gzip
	header {
		defer
		delete X-Powered-By
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy grafana:3000
}

# Metriken des Proxies selbst fuer den Prometheus-Job "caddy" (AGENTS.md: jeder
# Dienst bekommt ein Metrikziel). Der Admin-Endpunkt von Caddy horcht nur auf der
# Container-Loopback; hier wird ausschliesslich /metrics durchgereicht. Der Port
# ist nicht veroeffentlicht, erreichbar also nur fuer Container in den Netzen
# llm-observability und llm-inference - Prometheus erreichte den Host-Loopback
# bei rootless Podman nie, die Container-Namen aber jederzeit.
:8080 {
	# Der Admin-Endpunkt von Caddy prueft den Host-Namen und antwortet 403 fuer
	# fremde Namen (Schutz vor DNS-Rebinding) - deshalb hier die Loopback-Adresse
	# als Host, sonst liefert der Job nur 403.
	reverse_proxy /metrics 127.0.0.1:2019 {
		header_up Host 127.0.0.1:2019
	}
}

# --- LAN-Zugang ---------------------------------------------------------------
# Gerendert aus config/proxy/Caddyfile.template durch scripts/74-setup-local-proxy.sh.
# Alle Namen enden auf den Rechnernamen (cachyos-x8664); Windows-Clients tragen sie in
# C:\Windows\System32\drivers\etc\hosts ein (docs/operations.md, Abschnitt LAN-Zugang).
# Dozzle, Grafana und direct-llm sind ohne Proxy-Anmeldung fuer das private LAN.

homepage.cachyos-x8664 {
	tls internal
	encode zstd gzip

	handle /anleitung* {
		root * /srv/llm-proxy/site
		file_server
	}

	handle {
		reverse_proxy llm-homepage:3000
	}
}

grafana.cachyos-x8664 {
	# Bewusst ohne Anmeldung: anonyme Lese-Rolle in ~/.config/llm-infra/grafana.env.
	# Der Unterpfad /grafana/ bleibt, damit GF_SERVER_ROOT_URL weiterhin passt.
	# Grafana leitet auf seine root_url https://grafana.localhost/grafana/ und
	# wuerfe LAN-Besucher damit auf den Loopback-Namen zurueck, den nur dieser
	# Rechner kennt. Die Umleitung bleibt deshalb auf dem Namen der Anfrage.
	tls internal
	encode zstd gzip
	reverse_proxy grafana:3000 {
		header_down Location "https://grafana.localhost/" "https://{http.request.host}/"
	}
}

# Gateway (LiteLLM): verlangt den eigenen Virtual-Key, 401 ohne Schluessel.
littlem.cachyos-x8664 {
	tls internal
	encode zstd gzip
	reverse_proxy litellm:4000
}

# Alias von littlem.cachyos-x8664: dieselbe Adresse unter dem Namen von 2026-11-17.
llm-direct.cachyos-x8664 {
	tls internal
	encode zstd gzip
	reverse_proxy litellm:4000
}

# Container-Logs: ohne Anmeldung, nur auf den vertrauenswuerdigen LAN-Adressen.
dozzle.cachyos-x8664 {
	tls internal
	encode zstd gzip
	header {
		defer
		delete X-Powered-By
		Strict-Transport-Security "max-age=31536000"
	}
	# rate_limit (geplant): die Caddy-Fassung 2-alpine/v2.11.9 kennt die Richtlinie
	# in diesem Build nicht - Zugangspruefung bleibt Sache von Firewall und Zugang.
	log {
		output stdout
	}
	reverse_proxy dozzle:8080
}

# vLLM direkt, ohne API-Schluessel oder Proxy-Anmeldung. Der Zugriff auf diese
# Site ist auf LAN_BIND_IPS beschraenkt; Ziel ist der Weiterleiter auf dem Host.
direct-llm.cachyos-x8664 {
	tls internal
	encode zstd gzip
	header {
		defer
		delete X-Powered-By
		Strict-Transport-Security "max-age=31536000"
	}
	# rate_limit (geplant): die Caddy-Fassung 2-alpine/v2.11.9 kennt die Richtlinie
	# in diesem Build nicht - Zugangspruefung bleibt Sache von Firewall und Zugang.
	log {
		output stdout
	}
	reverse_proxy host.containers.internal:30001
}

# Bootstrap fuer Clients, die die Namen/CA noch nicht kennen: HTTP auf Port 80
# (am Host 8081) liefert nur das oeffentliche Root-Zertifikat und das ZIP.
# Die Root-Echtheit wird vor dem Import per Fingerabdruck geprueft; alle anderen
# Pfade antworten 404.
:80 {
	@wurzel {
		path /caddy-local-authority-root.crt
	}
	handle @wurzel {
		root * /srv/llm-proxy/ca
		file_server
	}
	@anleitung {
		path /anleitung/anleitung.zip
	}
	handle @anleitung {
		root * /srv/llm-proxy/site
		file_server
	}
	handle {
		respond "Nur Wurzelzertifikat und Installationspaket" 404
	}
}

# Unbekannte Hostnamen: keine Site, keine Weiterleitung an einen Backend-Port.
:443 {
	tls internal
	respond "Unbekannter Name" 403
}
