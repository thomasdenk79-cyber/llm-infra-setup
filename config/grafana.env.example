# Vorlage fuer ~/.config/llm-infra/grafana.env (0600, ausserhalb von Git).
# Erzeugt und vergleichen von scripts/60-install-monitoring.sh; diese Datei
# erklart nur die Felder. Die Datei gehoert dem Skript: bei Abweichung wird
# sie mit Zeitstempel-Sicherung neu geschrieben.
#
# Warum das noetig ist: Grafana bedient mehrere Zugangwege aus einer Instanz -
# den lokalen HTTPS-Zugang ueber Namen (scripts/74-setup-local-proxy.sh,
# Host grafana.localhost) und den oeffentlichen Zugang der Kollegen ueber
# Caddy auf dem Azure-Gateway (Unterpfad /grafana/, Basic-Auth pro Person,
# docs/gateway-proxy.md). Grafana kann nur eine Wurzel-Adresse haben; die
# Folgen fuer die absolute Links ausserhalb des gewaehlten Zugangwegs sind in
# docs/operations.md und docs/HANDOFF.md beschrieben.

# Adresse, unter der Grafana ausgeliefert wird - inkl. Unterpfad. Der lokale
# Proxy ist der Hauptzugang: er antwortet ohne 301 auf die Gateway-Adresse,
# weil diese Wurzel zu seinem Host passt.
GF_SERVER_ROOT_URL=https://grafana.localhost/grafana/

# Grafana bedient die Seiten erst ab dem Pfad aus GF_SERVER_ROOT_URL.
# Noetig, damit Assets unter /grafana/public/ statt /public/ liegen -
# sonst brechen Portal-Einbettungen und der Gateway-Weg.
GF_SERVER_SERVE_FROM_SUB_PATH=true

# Lesen ohne Anmeldung (Betreiberausdruck 2026-11-16): anonyme Besuche
# bekommen die Lese-Rolle der Standard-Organisation. Der oeffentliche Zugang
# bleibt vorgelagert durch Basic-Auth auf dem Gateway geschuetzt (401 ohne
# Zugangswerte) - anonym gilt erst hinter dieser Schranke.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
# Explore-Ansicht fuer Zuschauer (Betreiberfreigabe 2026-11-18): ohne diesen
# Schluessel ist /grafana/explore fuer anonyme Besuche verschlossen. Der
# Zuschauer darf dadurch Log- und Metrikfragen stellen, aber nichts speichern.
GF_USERS_VIEWERS_CAN_EDIT=true
GF_AUTH_DISABLE_LOGIN_FORM=true

# Panel-Einbettungen ins Portal (d-solo-Adressen im iframe): ohne diesen
# Schluessel antwortet Grafana mit X-Frame-Options: deny und die Kachel
# bleibt weiss. Abnahme: curl auf /grafana/d-solo/<uid>?panelId=N liefert 200
# ohne Cookies, und der Kopf der Antwort enthaelt kein X-Frame-Options: deny.
GF_SECURITY_ALLOW_EMBEDDING=true
