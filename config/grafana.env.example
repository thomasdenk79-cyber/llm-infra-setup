# Vorlage fuer ~/.config/llm-infra/grafana.env (0600, ausserhalb von Git).
# Erzeugt von scripts/60-install-monitoring.sh; diese Datei erklart nur die Felder.
#
# Warum das noetig ist: der oeffentliche Zugang der Kollegen haengt hinter Caddy
# an Port 443 und bedient mehrere Dienste aus einem Serverblock - Grafana unter
# /grafana/. Grafana muss seine Links und Assets dann selbst unter diesem
# Unterpfad anbieten, sonst erscheinen login-Seite und Dashboards ungestylt oder
# fehlerhaft. Siehe docs/gateway-proxy.md.

# Oeffentliche Adresse, unter der Grafana erreichbar ist - inkl. Unterpfad.
# Ohne Gateway (nur lokaler Zugriff) bleibt der Standardwert http://127.0.0.1:3000/grafana/
GF_SERVER_ROOT_URL=https://gateway.example.com/grafana/

# Grafana bedient die Seiten erst ab dem Pfad aus GF_SERVER_ROOT_URL.
GF_SERVER_SERVE_FROM_SUB_PATH=true
