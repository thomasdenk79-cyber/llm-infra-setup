// Container-Logsammlung fuer Loki.
//
// Der Podman-Socket wird ueber die Docker-kompatible API gelesen. Wichtige
// Details, die in der ersten Version gefehlt haben:
//   * discovery.docker liefert Meta-Labels wie __meta_docker_container_name
//     (mit fuehrendem Schragschrich, z. B. "/pennyroyal"). Ohne Relabel landen
//     alle Containers unter einem ununterscheidbaren Strom.
//   * der Schragschrich wird hier entfernt, damit die Suche nach
//     {container="pennyroyal"} funktioniert.
//
// Der Socket wird im Quadlet quadlet/alloy.container eingebunden
// (%t/podman/podman.sock). Mehr dazu in docs/monitoring.md.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
  rule {
    target_label = "job"
    replacement  = "containerlogs"
  }

  // GPU-Rauchmelder aussortieren: die llm-infra-Pruefskripte
  // scripts/30-nvidia-podman.sh und scripts/44-isolate-blackwell.sh starten
  // je Lauf zwei anonyme "podman run --rm docker.io/nvidia/cuda ... nvidia-smi -L"
  // Container. Sie sind in kuerzester Zeit weg, aber loki.source.docker behaelt
  // das Ziel und inspectet es auf ewig weiter ("error inspecting Docker
  // container ... no such container") — Upstream-Fehler grafana/alloy#3054,
  // gepinnte Version v1.10.2 kennt den Fix (PR #6309) noch nicht.
  // Smoke-Test-Logs werden in Loki nicht gebraucht; drop vor dem Tailing
  // haelt die Targets sauber. Akte: 2026-11-18-fleet-journal-error-burst.
  rule {
    source_labels = ["__meta_docker_container_image"]
    regex         = "docker.io/nvidia/cuda(:.*)?"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.parse.receiver]
  labels     = { stack = "llm-infra" }
}

// Zeitstempel der Runtime uebernehmen, damit die Reihenfolge in der Suche stimmt.
loki.process "parse" {
  stage.timestamp {
    source            = "time"
    format            = "RFC3339"
    action_on_failure = "fudge"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---------------------------------------------------------------------------
// vLLM (flash-next-v3) ueber das Journal statt ueber die Docker-API.
//
// Grund: flash-next-v3 lief mit "podman run" und HostConfig.LogConfig.Type=
// journald. discovery.docker sieht den Container zwar, aber loki.source.docker
// kann ihn nicht tailen - die Docker-kompatible API des Podman-Sockets liefert
// fuer den journald-Treiber keinen Logstream (im Alloy-Log: "error inspecting
// Docker container ... no such container"). Deshalb tauchten nur die reinen
// Quadlet-Container (systemd-grafana, systemd-loki, ...) mit
// stack="llm-infra", job="containerlogs" in Loki auf, vLLM nie.
//
// Die vLLM-Ausgabe liegt im Journal des Benutzers (rootless Podman; conmon
// schreibt sie): journalctl --user zeigt Eintraege mit dem Feld
// CONTAINER_NAME=flash-next-v3. In Alloy ist das zustaendige Component
// "loki.source.journal" (nicht "loki.source.journald"); es liest ueber
// libsystemd und braucht dafuer die Journal-Dateien im Container - siehe die
// Volume-Zeilen in ~/.config/containers/systemd/alloy.container.
//
// `matches` filtert bereits in journald (AND-Match). Die relabel-Regel
// (action=keep auf dem internen Label __journal_container_name) ist die
// ausdrueckliche Absicherung, dass kein anderer Container mitkommt. Eigene
// `labels` ueberschreiben das von Alloy automatisch gesetzte job-Label.
loki.relabel "vllm_journal" {
  forward_to = []

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "qwen38-rc2|flash-next-v3"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }
}

loki.source.journal "vllm" {
  forward_to    = [loki.write.local.receiver]
  relabel_rules = loki.relabel.vllm_journal.rules
  path          = "/var/log/journal"
  matches       = "CONTAINER_NAME=qwen38-rc2"
  labels        = { job = "containerlogs", stack = "llm-infra" }
  max_age       = "2h"
}

loki.source.journal "vllm_alt" {
  forward_to    = [loki.write.local.receiver]
  relabel_rules = loki.relabel.vllm_journal.rules
  path          = "/var/log/journal"
  matches       = "CONTAINER_NAME=flash-next-v3"
  labels        = { job = "containerlogs", stack = "llm-infra" }
  max_age       = "2h"
}
