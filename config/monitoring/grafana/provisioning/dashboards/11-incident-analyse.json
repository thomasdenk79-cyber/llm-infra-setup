e"}, "targets": [{"refId": "A", "expr": "scalar(time()) - min(max_over_time(llm_service_start_time_seconds{name=~\"$service\"}[1h]))", "instant": true}]}, {"type": "row", "title": "Phasenverlauf und KI-Befunde (Loki job=incident)", "collapsed": false, "panels": [], "id": 14, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6}}, {"type": "logs", "title": "Phasenverlauf (neueste zuerst)", "id": 15, "description": "Loki job=\"incident\": detektierte -> analysiert -> aktualisiert -> geloeste Phasen. Gefiltert ueber die Variablen 'service' und 'alertname'.", "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"}, "gridPos": {"h": 12, "w": 14, "x": 0, "y": 7}, "options": {"showTime": true, "wrapLogMessage": true, "dedupEnabled": false, "enableLogDetails": true, "prettifyLogMessage": false, "sortOrder": "Descending", "showLabels": false, "showCommonLabels": false}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"}, "queryType": "range", "expr": "{job=\"incident\", service=~\"$service\", alertname=~\"$alertname\"}"}]}, {"type": "logs", "title": "KI-Befunde (Phasen analysing/update)", "id": 16, "description": "Nur Analyse-/Aktualisierungszeilen des KI-Agenten aus job=\"incident\" (phase=~\"analyzing|update\").", "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"}, "gridPos": {"h": 12, "w": 10, "x": 14, "y": 7}, "options": {"showTime": true, "wrapLogMessage": true, "dedupEnabled": false, "enableLogDetails": true, "prettifyLogMessage": false, "sortOrder": "Descending", "showLabels": false, "showCommonLabels": false}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "P8E80F9AEF21F6940"}, "queryType": "range", "expr": "{job=\"incident\", phase=~\"analyzing|update\", service=~\"$service\", alertname=~\"$alertname\"}"}]}, {"type": "row", "title": "Kundenstatus und Tickets", "collapsed": false, "panels": [], "id": 17, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 19}}, {"type": "table", "title": "Aktueller Kundenstatus", "id": 18, "description": "llm_customer_status_info: service/state/message/eta - was der Kunde sieht, aktualisiert vom Incident-Agenten.", "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"}, "gridPos": {"h": 8, "w": 14, "x": 0, "y": 20}, "fieldConfig": {"defaults": {"unit": "short", "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": false}}, "overrides": [{"matcher": {"id": "name", "options": "Status"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "color-background"}}, {"id": "mappings", "value": [{"type": "value", "options": {"ok": {"text": "Betriebsbereit", "color": "green"}, "investigating": {"text": "Stoerung erkannt, in Bearbeitung", "color": "orange"}, "degraded": {"text": "Eingeshraenkt", "color": "yellow"}, "down": {"text": "Ausser Betrieb", "color": "red"}}}]}]}]}, "options": {"showHeader": true, "footer": {"show": false, "reducer": [], "count": false}}, "targets": [{"refId": "A", "expr": "llm_customer_status_info", "format": "table", "instant": true}], "transformations": [{"id": "labelsToFields", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "job": true, "instance": true}, "renameByName": {"service": "Dienst", "state": "Status", "message": "Meldung", "eta": "Vorhersage"}}}]}, {"type": "text", "title": "Ticket-Grundlage (SQL/Demo)", "id": 19, "gridPos": {"h": 8, "w": 10, "x": 14, "y": 20}, "options": {"mode": "markdown", "content": "**So entsteht die Grundlage des Tickets**\n\n1. Alarm feuert -> der Incident-Agent (914er Container) analysiert ueber das eigene Gateway.\n2. Befunde erscheinen als Logs in Loki (`job=\"incident\"`, Phasen `detected|analyzing|update|resolved`).\n3. Der Agent schreibt ein Ticket in die SQLite-Datenbank von `scripts/incident-agent/server.py` (Tabelle `tickets`).\n\nDie KI-Befunde sind damit zweifach nutzbar: als Log-Zeile fuer die Nachvollziehung und als Datenbasis fuer das Ticket. Die ETA aus der Analyse landet zusaetzlich in `llm_service_downtime_estimate_seconds` (-1 = unbekannt). Externe Quellen (Splunk, Oracle, OpenShift, Nagios, Ticketsystem per MCP) sind dokumentierte Adapter-Stubs."}}]}