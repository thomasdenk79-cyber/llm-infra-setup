# Vorlage fuer config/gateway-proxy.env (lokal, nicht committen - enthaelt keine
# Geheimnisse, aber die echten Zielangaben des Gateway-Rechners).
#
#   cp config/gateway-proxy.env.example config/gateway-proxy.env
#   ./scripts/70-setup-gateway-proxy.sh --check
#   ./scripts/70-setup-gateway-proxy.sh

# Erreichbarer Name des Gateway-Rechners. Beides wird in den Caddy-Serverblock
# geschrieben, damit die Kollegen wahlweise den DNS-Namen oder die oeffentliche
# IP ansprechen koennen; ohne die IP im Block antwortet Caddy auf https://<IP>
# mit einem TLS-Internal-Fehler, weil kein Serverblock zum Namen passt.
GATEWAY_DNS_NAME=edipoc-gateway.example
GATEWAY_PUBLIC_IP=203.0.113.10

# SSH-Zugang des Dienstkontos, das den Tunnel baut. Der Schluessel wird nur zum
# Bauen der Weiterleitungen benutzt und auf dem Gateway auf genau diese
# Loopback-Ports beschraenkt (permitlisten in authorized_keys).
GATEWAY_VM_USER=azureuser
GATEWAY_VM_SSH_PORT=22
GATEWAY_SSH_KEY=%h/.ssh/llm_gateway_tunnel_ed25519
# Anmeldeschluessel, mit dem der Tunnel-Schluessel beim ersten Lauf auf dem
# Gateway hinterlegt wird (danach wird er nicht mehr gebraucht).
GATEWAY_BOOTSTRAP_KEY=%h/.ssh/id_ed25519

# Weitergeleitete Dienste: Loopback auf dem Gateway, Gegenstelle ist der Loopback
# dieses Rechners. Die Ports müssen zu den PublishPort-Angaben der Quadlets passen.
GATEWAY_LITELLM_PORT=4000
GATEWAY_GRAFANA_PORT=3000
GATEWAY_HOMEPAGE_PORT=3002

# zusaetzlicher Wartungs-SSH-Port auf dem Gateway (0 = aus).
GATEWAY_ADMIN_FORWARD_PORT=0

# TLS: internal = Caddy-eigene CA (Kollegen muessen die CA importieren oder
# -k/-Insecure nutzen). acme = echtes Zertifikat, dann GATEWAY_LE_EMAIL setzen.
GATEWAY_TLS_MODE=internal
GATEWAY_LE_EMAIL=

# Basic-Auth fuer Grafana und Homepage: Datei mit einer Zeile pro Person im
# Format "benutzer bcrypt-hash". Erzeugen: ./scripts/70-setup-gateway-proxy.sh --hash NAME
# Die Datei enthaelt nur Hashes, liegt aber trotzdem ausserhalb von Git.
GATEWAY_TEAM_USERS_FILE=%h/.config/llm-infra/gateway-proxy/team-users.txt

# Pfad des Caddyfiles auf dem Gateway.
GATEWAY_CADDY_FILE=/etc/caddy/Caddyfile
