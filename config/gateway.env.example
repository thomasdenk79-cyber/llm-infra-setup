# LiteLLM gateway settings. Copy to config/gateway.env and keep credentials out of Git.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.101.0
LITELLM_PORT=4000
PENNYROYAL_BASE_URL=http://127.0.0.1:8001/v1
LITELLM_MASTER_KEY=change-me
LITELLM_SALT_KEY=change-me


# Set after starting the local PostgreSQL service
DATABASE_URL=postgresql://litellm:CHANGE_ME@127.0.0.1:5432/litellm
