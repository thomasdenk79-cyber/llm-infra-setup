# Konfiguration fuer scripts/70-setup-gateway-proxy.sh
# Kopieren nach config/gateway.env (nicht in Git) und ausfuellen.

# Azure-Gateway-VM
GATEWAY_HOST=20.73.54.102
GATEWAY_SSH_USER=azureuser
GATEWAY_SSH_PORT=22

# Schluessel der lokalen CachyOS-Maschine: Tunnel-Schluessel fuer den
# Autossh-Reverse-Tunnel und separater Verwaltungs-Schluessel fuer die VM.
GATEWAY_SSH_KEY=%h/.ssh/llm_gateway_reverse_ed25519
GATEWAY_ADMIN_KEY=%h/.ssh/llm_gateway_admin_ed25519

# Fuer ein vertrauenswuerdiges oeffentliches Zertifikat: DNS-Namen der VM
# setzen (z. B. Azure-DNS-Label edipoc-gateway.<region>.cloudapp.azure.com).
GATEWAY_DNS_NAME=edipoc-gateway.westeurope.cloudapp.azure.com
GATEWAY_ACME_EMAIL=

# TLS-Modus: internal = Caddy-eigene CA (passt zur beschraenkten NSG; Team
# installiert das Stammzertifikat einmalig), letsencrypt = vertrauenswuerdig,
# erfordert aber dauerhaft oeffentlich erreichbaren Port 443.
GATEWAY_TLS=internal

# Loopback-Ziele auf der Gateway-VM (kommen durch den Reverse-Tunnel von CachyOS)
GATEWAY_LITELLM_PORT=4000
GATEWAY_GRAFANA_PORT=3000
GATEWAY_HOMEPAGE_PORT=3002

# Team-Namen fuer die Basic-Auth von Grafana und Homepage. Passwoerter
# erzeugt das Skript einmalig in ~/.config/llm-infra/gateway-web-auth/
# (0600) - niemals in Git, Tickets oder Chats kopieren.
GATEWAY_TEAM_USERS="owner martin johannes holger"

# Live verifizierter SSH-Host-Key der Gateway-VM (ED25519). Das Skript bricht
# bei Abweichung ab. Wert ist oeffentlich, kein Geheimnis.
GATEWAY_HOST_KEY_FINGERPRINT=SHA256:rDkL6da/9HUzecqAq5JS0TB1lhQh8F3fKsdA85AbjGo

# Port 22 (SSH): nur noch CachyOS fuer Autossh-Tunnel und VM-Verwaltung.
# Komma- oder leerzeichengetrennt; keine Praezixe, die einander enthalten -
# das Azure-Portal weist Ueberschneidungen in einer Regel ab.
GATEWAY_ALLOWED_SSH_CIDRS=92.209.14.229/32

# Port 443/80 (Browser: LiteLLM-API, Grafana, Homepage): Buero-Zscaler
# Muenchen plus eigene Netze. Schutz pro Person = Basic-Auth bzw. LiteLLM-Token.
GATEWAY_ALLOWED_WEB_CIDRS=147.161.168.0/22,147.161.176.0/23,147.161.250.0/23,92.209.14.229/32

# Optionaler Entra-ID-Login in Grafana (cloudseitiges Spiegelbild des
# Firmen-Active-Directory). Werte aus einer Azure-App-Registrierung mit
# Umleitungs-URI https://<GATEWAY_DNS_NAME>/login/azuread.
GATEWAY_AZUREAD_TENANT_ID=
GATEWAY_AZUREAD_CLIENT_ID=
GATEWAY_AZUREAD_CLIENT_SECRET=
GATEWAY_AZUREAD_ALLOWED_DOMAINS=siemens.com
