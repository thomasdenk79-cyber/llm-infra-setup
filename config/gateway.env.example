# Konfiguration fuer scripts/70-setup-gateway-proxy.sh
# Kopieren nach config/gateway.env (nicht in Git) und ausfuellen.

# Azure-Gateway-VM
GATEWAY_HOST=20.73.54.102
GATEWAY_SSH_USER=azureuser
GATEWAY_SSH_PORT=22

# Schluessel der lokalen CachyOS-Maschine: Tunnel-Schluessel fuer den
# Autossh-Reverse-Tunnel und separater Verwaltungs-Schluessel fuer die VM.
GATEWAY_SSH_KEY=%h/.ssh/llm_gateway_reverse_ed25519
GATEWAY_ADMIN_KEY=%h/.ssh/llm_gateway_admin_ed25519

# Fuer ein vertrauenswuerdiges oeffentliches Zertifikat: DNS-Namen der VM
# setzen (z. B. Azure-DNS-Label edipoc-gateway.<region>.cloudapp.azure.com).
# Leer lassen: Caddy nutzt ein selbst signiertes "tls internal"-Zertifikat.
GATEWAY_DNS_NAME=
GATEWAY_ACME_EMAIL=

# Loopback-Ziele auf der Gateway-VM (kommen durch den Reverse-Tunnel von CachyOS)
GATEWAY_LITELLM_PORT=4000

# Live verifizierter SSH-Host-Key der Gateway-VM (ED25519). Das Skript bricht
# bei Abweichung ab. Wert ist öffentlich, kein Geheimnis.
GATEWAY_HOST_KEY_FINGERPRINT=SHA256:rDkL6da/9HUzecqAq5JS0TB1lhQh8F3fKsdA85AbjGo

# Kreise (CIDR), die ueber Port 22 auf die Gateway-VM duerfen. Leere Liste =
# Skript prueft und zeigt nur die aktuelle oeffentliche IP, aendert nichts.
# Wichtig: Jede Person, die den SSH-Tunnel fuer Grafana/Homepage nutzt
# (z. B. martin, johannes, holger), braucht ihren eigenen Netz-Kreis hier -
# sonst sperrt die Azure-Netzwerkregel sie aus, unabhaengig vom SSH-Schluessel.
GATEWAY_ALLOWED_SSH_CIDRS=92.209.14.229/32
