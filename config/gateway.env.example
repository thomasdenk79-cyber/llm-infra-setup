# Kopieren nach gateway.env (chmod 600) und Werte setzen; niemals committen.
LITELLM_MASTER_KEY=sk-platzhalter
LITELLM_SALT_KEY=sk-platzhalter
DATABASE_URL=postgresql://platzhalter
LLM_INFRA_API_KEY=sk-platzhalter
# Dummy-Key fuer den lokalen Bonsai-Fallback (llama-server prueft ihn nicht).
FALLBACK_API_KEY=sk-lokaler
# Luna (Stufe 3) braucht KEINEN Schluessel: ChatGPT-Geraet-Login, Token unter
# ~/.config/llm-infra/chatgpt-tokens/ (vom Container eingerichtet und erneuert).
# Siemens LLM API (free, Scope llm): Key NUR in ~/.config/llm-infra/gateway.env.
# Fundort des Werts (OneDrive, nicht committen):
#   C:\Users\z000g9hu\OneDrive - Siemens AG\tools\myconfigfiles\code.siemens.com_api_ai_token.txt
# Modelle: deepseek-v4.1-flash (bevorzugt, anders denkend als qwen), siemens-qwen-3.8-27b
# (Cloud-Vergleichspunkt zu bonsai). ACHTUNG: langsam + always-reasoning, max_tokens>=512.
SIEMENS_LLM_API_KEY=***
