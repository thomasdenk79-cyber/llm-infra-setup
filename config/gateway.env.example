# LiteLLM gateway settings. Copy to config/gateway.env and keep credentials out of Git.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.101.0
LITELLM_PORT=4000
PENNYROYAL_BASE_URL=http://pennyroyal:8001/v1
LITELLM_MASTER_KEY=***
LITELLM_SALT_KEY=***


# Set after starting the local PostgreSQL service
DATABASE_URL=postgresql://litellm:***@litellm-postgres:5432/litellm

# Optionaler Failover-Deployment unter demselben model_name qwen3.8-flash-next
# (GPU-Fenster-Ausfall). Leer gelassen = unveraendertes Verhalten: der Generator
# schreibt exakt den bisherigen Einzeld-Eintrag. Sind MODEL und KEY gesetzt,
# erscheint ein zweiter Eintrag und der LiteLLM-Router failovert automatisch,
# wenn Pennyroyal nicht erreichbar ist (num_retries/cooldown in router_settings
# greifen vorher weiter). Der Schluesselwert liegt NUR in der Laufzeit-Umgebung
# (~/.config/llm-infra/gateway.env, via os.environ gelesen) - nie in der
# committeten YAML.
# Beispiel: github_copilot/claude-sonnet-4.5 oder gemini/gemini-2.5-pro
FALLBACK_LITELLM_MODEL=
FALLBACK_API_KEY=
*** optional; nur fuer Provider mit eigenem Endpoint noetig
FALLBACK_API_BASE=
