# GENERIERT von scripts/70-setup-gateway-proxy.sh. Nicht manuell auf dem
# Gateway editieren - Aenderungen gehoeren in diese Vorlage und config/gateway-proxy.env.
#
# Platzhalter (werden lokal eingesetzt):
#   __SITE_ADDRESSES__  durch Leerzeichen getrennte Adressen, z. B.
#                       "https://gateway.example https://203.0.113.10"
#   __TLS_BLOCK__       "tls internal" oder "tls /pfad/cert.pem /pfad/key.pem"
#   __LE_EMAIL__        optional "email <adresse>" fuer Let's Encrypt
#   __LITELLM_PORT__    Loopback-Port des LiteLLM-Tunnels auf dem Gateway
#   __GRAFANA_PORT__    Loopback-Port des Grafana-Tunnels
#   __HOMEPAGE_PORT__   Loopback-Port des Homepage-Tunnels
#   __TEAM_USERS__      Zeilen "benutzer <bcrypt-hash>" fuer basic_auth
#
# Freigaben: /v1 (LiteLLM, Schutz = persoenlicher Virtual Key), /grafana/
# (Grafana im Unterpfad, zusaetzlich Basic-Auth pro Person) und der Rest als
# Homepage hinter Basic-Auth. Ohne gaeltige Basic-Zugangsdaten antwortet 401.

{
	# Admin-API bewusst auf dem Loopback: ohne sie schlaegt ein schonendes
	# "systemctl reload caddy" fehl (ExecReload braucht sie), ein Restart wuerde
	# jede laufende Kollegen-Anfrage abbrechen. Von aussen ist 2019 nicht erreichbar.
	admin 127.0.0.1:2019
	# Wer ohne SNI verbindet (direkt ueber die oeffentliche IP), bekommt trotzdem
	# ein Zertifikat: es ist das des DNS-Namens, daher dort Zertifikatswarnung.
	default_sni __DEFAULT_SNI__
}

__SITE_ADDRESSES__ {
	__TLS_BLOCK__ __LE_EMAIL__
	encode zstd gzip

	@litellm path /v1 /v1/* /health/liveliness /health/readiness
	handle @litellm {
		reverse_proxy 127.0.0.1:__LITELLM_PORT__
	}

	@grafana path /grafana /grafana/*
	handle @grafana {
		basic_auth {
__TEAM_USERS__
		}
		reverse_proxy 127.0.0.1:__GRAFANA_PORT__ {
			header_up X-Forwarded-Prefix /grafana
		}
	}

	handle {
		basic_auth {
__TEAM_USERS__
		}
		reverse_proxy 127.0.0.1:__HOMEPAGE_PORT__ {
			header_up Host {upstream_hostport}
		}
	}
}
