# GENERIERT von scripts/70-setup-gateway-proxy.sh. Nicht manuell auf dem
# Gateway editieren - Aenderungen gehoeren in diese Vorlage und config/gateway.env.
#
# Platzhalter (werden lokal eingesetzt):
#   __SITE__            DNS-Name oder https://<IP>
#   __TLS__             "tls internal" oder leer (automatisches Let's Encrypt)
#   __GLOBAL_TAIL__     optional "email <adresse>" fuer Let's Encrypt
#   __LITELLM_PORT__    Loopback-Port des LiteLLM-Tunnels auf dem Gateway
#   __GRAFANA_PORT__    Loopback-Port des Grafana-Tunnels
#   __HOMEPAGE_PORT__   Loopback-Port des Homepage-Tunnels
#   __TEAM_USERS__      Zeilen "benutzer <bcrypt-hash>" fuer basic_auth
#
# Freigaben: /v1 (LiteLLM, Schutz = persoenlicher Virtual Key), /grafana/
# (Grafana im Unterpfad, zusaetzlich Basic-Auth pro Person) und der Rest als
# Homepage hinter Basic-Auth. Ohne gaeltige Basic-Zugangsdaten antwortet 401.

{
	admin off
	__GLOBAL_TAIL__
}

__SITE__ {
	__TLS__
	encode zstd gzip

	@litellm path /v1 /v1/* /health/liveliness /health/readiness
	handle @litellm {
		reverse_proxy 127.0.0.1:__LITELLM_PORT__
	}

	@grafana path /grafana /grafana/*
	handle @grafana {
		basic_auth {
			__TEAM_USERS__
		}
		reverse_proxy 127.0.0.1:__GRAFANA_PORT__
	}

	handle {
		basic_auth {
			__TEAM_USERS__
		}
		reverse_proxy 127.0.0.1:__HOMEPAGE_PORT__ {
			header_up Host {upstream_hostport}
		}
	}
}
