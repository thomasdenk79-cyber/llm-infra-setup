# Copy to host.env and keep secrets outside Git.
LLM_MODELS_DIR=/srv/llm/models
LLM_CACHE_DIR=/srv/llm/cache
LLM_NIXL_DIR=/srv/llm/nixl
PENNYROYAL_PORT=8001
PENNY_HICACHE_SIZE_GB=16
LITELLM_PORT=4000

ZFS_POOL=zpcachyossrv
PENNY_PLE_BACKEND=nvme
PENNY_PLE_NVME_MODEL=/srv/llm/ple-native/Qwen3.8-Flash-Next-PLE-NVME
ZFS_ARC_MAX_GB=16
PLE_STORAGE_IMAGE=/srv/llm/ple-nvme.ext4
PLE_STORAGE_MOUNT=/srv/llm/ple-ext4
PLE_STORAGE_SIZE_GB=110
PENNY_SPEC_NUM_STEPS=3
PENNY_SPEC_EAGLE_TOPK=1
PENNY_SPEC_NUM_DRAFT_TOKENS=4
PENNY_SLEEP_ON_IDLE=0
PENNY_CHUNKED_PREFILL_SIZE=4096
PENNY_MAX_RUNNING_REQUESTS=6
PENNY_MAX_MAMBA_CACHE_SIZE=36
PENNY_MAX_TOTAL_TOKENS=1048576
PENNY_CUDA_GRAPH_MAX_BS=6
PENNY_ENABLE_MEMORY_SAVER=1
PENNY_ONLINE_FP8=true
