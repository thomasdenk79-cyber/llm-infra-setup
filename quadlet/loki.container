[Unit]
Description=Loki log aggregation
After=llm-observability-network.service

[Container]
Image=docker.io/grafana/loki:3.5.2
Network=llm-observability.network
NetworkAlias=loki
PublishPort=127.0.0.1:3100:3100
Volume=%h/.local/share/llm-infra/loki:/loki:Z,U
Volume=@CONFIG_ROOT@/config/monitoring/loki.yml:/etc/loki/config.yml:ro,Z
# log.level als CLI-Flag (Loki 3.5.2 kennt log_level nicht in der config-Datei -
# mit ihr crasht der Start). Drosselt die Info-Flut pro Grafana-Query.
Exec=-config.file=/etc/loki/config.yml -log.level=warn

[Service]
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
