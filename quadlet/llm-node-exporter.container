# Host-Metriken (CPU, RAM, Platte, Netzwerk, ZFS, Temperaturen).
# Der Exporter läuft rootless in einem Container und liest den Host über die
# schreibgeschützte /host-Einhängung. Er sieht dadurch die echten Hostwerte und
# nicht nur die Containersicht. Texte Kennzahlen liefert scripts/collect-host-facts.sh.
[Unit]
Description=Prometheus node exporter (host metrics)
After=llm-observability-network.service

[Container]
Image=docker.io/prom/node-exporter:v1.9.1
ContainerName=llm-node-exporter
Network=llm-observability.network
PublishPort=127.0.0.1:9100:9100
Volume=/:/host:ro,rslave
Volume=%h/.local/share/llm-infra/node-exporter/textfile:/var/lib/node_exporter/textfile:ro,Z
Exec=--path.rootfs=/host --web.listen-address=0.0.0.0:9100 --collector.textfile.directory=/var/lib/node_exporter/textfile --collector.netdev.device-exclude=^(lo|veth|tap|docker|podman|cni|br-|wg|tun)

[Service]
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
