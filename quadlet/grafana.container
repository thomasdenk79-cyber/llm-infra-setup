[Unit]
Description=Grafana dashboards
After=llm-observability-network.service prometheus.service loki.service

[Container]
Image=docker.io/grafana/grafana:12.1.1
Network=llm-observability.network
NetworkAlias=grafana
PublishPort=127.0.0.1:3000:3000
Volume=%h/.local/share/llm-infra/grafana:/var/lib/grafana:Z,U
Volume=@CONFIG_ROOT@/config/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_SERVER_DOMAIN=edipoc-gateway.westeurope.cloudapp.azure.com
Environment=GF_SERVER_ROOT_URL=https://edipoc-gateway.westeurope.cloudapp.azure.com/grafana/
Environment=GF_SERVER_SERVE_FROM_SUB_PATH=true
EnvironmentFile=-%h/.config/llm-infra/grafana.env
Secret=grafana_admin_password,type=env,target=GF_SECURITY_ADMIN_PASSWORD

[Service]
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
