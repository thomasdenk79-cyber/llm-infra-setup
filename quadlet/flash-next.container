# GENERIERT von scripts/76-setup-runtime-unit.sh - dort aendern, nicht hier.
# Massgeblich ist config/runtime/flash-next.spec; die Datei hier ist dessen Ausgabe.
# Bild, Schalter und Geraete kommen aus der Aufnahme des laufenden Containers,
# damit die Laufzeit nach einem Neustart exakt so laeuft wie vorher.

[Unit]
Description=LLM-Inferenz-Laufzeit flash-next (vLLM, sm120-Schalter aus dem Betreiber-Fork)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/qwen38-fp4-tp1:v3
ContainerName=flash-next-v3
Network=pasta
PublishPort=127.0.0.1:30000:8000
AddDevice=nvidia.com/gpu=GPU-780d3589-9811-40ec-db66-93a9146697f3
AddDevice=/dev/dri/card0
AddDevice=/dev/dri/renderD129
Volume=/srv/llm-cache/torchinductor:/root/.cache/torchinductor
Volume=/srv/llm-cache/hf-download:/root/.cache/huggingface
Volume=/srv/llm-cache/b12x:/root/.cache/b12x
Volume=/srv/llm-cache/torch:/root/.cache/torch
Volume=/srv/llm-cache/triton:/root/.cache/triton
ShmSize=40g
PodmanArgs=--ipc=shareable
WorkingDir=/workspace
PodmanArgs=--security-opt=no-new-privileges
Ulimit=memlock=8388608:8388608
Ulimit=nofile=1048576:1048576
Ulimit=nproc=255212:255212
StopSignal=SIGTERM
Environment=B12X_DENSE_SPLITK_TURBO=1
Environment=B12X_DYNAMIC_DETERMINISTIC_OUTPUT=0
Environment=B12X_DYNAMIC_DIRECT_EXPERT_SCALES=1
Environment=B12X_DYNAMIC_SKIP_SPLIT_BARRIER_RESET=1
Environment=B12X_DYNAMIC_SPLIT_COMPUTE_MAC=224
Environment=B12X_DYNAMIC_SPLIT_FAST_PREPARE=1
Environment=B12X_DYNAMIC_SPLIT_LOW_SMEM=1
Environment=B12X_DYNAMIC_SPLIT_ROUTE_COMPUTE=1
Environment=B12X_DYNAMIC_WORK_SOURCE=persistent_grid
Environment=B12X_MHC_PDL=1
Environment=B12X_PCIE_ONESHOT_BLOCK_LIMIT=4
Environment=B12X_PCIE_ONESHOT_PDL=1
Environment=B12X_PCIE_ONESHOT_THREADS=512
Environment=CUDA_VISIBLE_DEVICES=0
Environment=HF_HUB_OFFLINE=1
Environment=NCCL_BUFFSIZE=2097152
Environment=NCCL_CUMEM_ENABLE=0
Environment=NCCL_IB_DISABLE=1
Environment=NCCL_MAX_NCHANNELS=16
Environment=NCCL_MIN_NCHANNELS=16
Environment=NCCL_P2P_LEVEL=SYS
Environment=NCCL_PROTO=LL,LL128,Simple
Environment=NVIDIA_CTK_LIBCUDA_DIR=/usr/lib
Environment=OMP_NUM_THREADS=2
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
Environment=QWEN38_DRAFT_DYNAMIC=1024
Environment=QWEN38_DRAFT_VOCAB=/opt/qwen38-v3/draft_vocab/top49152.json
Environment=TORCHINDUCTOR_CACHE_DIR=/root/.cache/torchinductor
Environment=TORCH_CUDA_ARCH_LIST=12.0a
Environment=TORCH_HOME=/root/.cache/torch
Environment=TRITON_CACHE_DIR=/root/.cache/triton
Environment=VLLM_B12X_DENSE_ACTIVATION_MODE=auto
Environment=VLLM_CAUSAL_CONV1D_UPDATE_HOIST=1
Environment=VLLM_COMPUTE_NANS_IN_LOGITS=0
Environment=VLLM_DISABLED_KERNELS=MarlinFP8ScaledMMLinearKernel
Environment=VLLM_ENABLE_PCIE_ALLREDUCE=1
Environment=VLLM_GDN_SPEC_DECODE_METADATA_FASTPATH=1
Environment=VLLM_LM_HEAD_A16=1
Environment=VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
Environment=VLLM_MTP_NVFP4_LM_HEAD=1
Environment=VLLM_MXFP8_LM_HEAD=0
Environment=VLLM_PCIE_ALLREDUCE_BACKEND=b12x
Environment=VLLM_PLE_CPU_OFFLOAD=1
Environment=VLLM_PLE_SHARED_TABLE_DIR=/dev/shm/lil-ple
Environment=VLLM_PLE_SHARED_TABLE_IDENTITY=nvidia/Qwen3.8-Flash-Next-FP4-Local@b9ce18a6887e18c089fdea8509a33e63429a3300
Environment=VLLM_PLE_TABLE_MEMORY=shared
Environment=VLLM_QWEN3_8_FLASH_NEXT_HC_TP=0
Environment=VLLM_QWEN3_8_FLASH_NEXT_MTP_COMPACT=1
Environment=VLLM_QWEN3_8_FLASH_NEXT_OVERLAP=1
Environment=VLLM_SSM_CONV_STATE_LAYOUT=DS
Environment=VLLM_USE_FASTOKENS=1
Environment=VLLM_USE_V2_MODEL_RUNNER=1
Environment=VLLM_WORKER_MULTIPROC_METHOD=spawn
Entrypoint=/opt/venv/bin/vllm
Exec=serve /root/.cache/huggingface/models--nvidia--Qwen3.8-Flash-Next-FP4-Local/snapshots/b9ce18a6887e18c089fdea8509a33e63429a3300 --host 0.0.0.0 --port 8000 --gpu-memory-utilization 0.96 --revision b9ce18a6887e18c089fdea8509a33e63429a3300 --served-model-name flash-next qwen3.8-flash-next --dtype bfloat16 --quantization modelopt_mixed --load-format instanttensor --block-size 64 --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"],"cudagraph_capture_sizes":[1,2,4,5,8,10,15,16,20,24,32,40,48,56,64]}' --mamba-cache-mode align --mamba-ssm-cache-dtype auto --moe-backend b12x --linear-backend b12x --gdn-decode-kernel b12x --no-enable-flashinfer-autotune --mm-encoder-tp-mode data --mm-processor-cache-gb 0 --async-scheduling --enable-prefix-caching --enable-prompt-tokens-details --enable-chunked-prefill --enable-auto-tool-choice --reasoning-parser qwen3 --tool-call-parser qwen3_xml --decode-context-parallel-size 1 --max-model-len 262144 --max-num-seqs 6 --kv-cache-dtype fp8 -tp 1 -pp 1 --max-cudagraph-capture-size 64 --max-num-batched-tokens 6144 --speculative-config '{"method":"mtp","num_speculative_tokens":4,"draft_sample_method":"probabilistic","rejection_sample_method":"standard","moe_backend":"b12x"}'
Label=llm-infra.runtime=1

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=infinity
TimeoutStopSec=180

[Install]
WantedBy=default.target
