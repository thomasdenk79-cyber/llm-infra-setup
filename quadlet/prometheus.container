# Prometheus sammelt Metriken. Es hängt absichtlich an beiden Netzen:
# im Observability-Netz erreicht es Loki/Grafana/Exporter, im Inferenz-Netz die
# Runtime (pennyroyal:8001/metrics) - ohne dass die Runtime exponiert wird.
[Unit]
Description=Prometheus metrics collector
After=llm-observability-network.service

[Container]
Image=docker.io/prom/prometheus:v3.5.0
Network=llm-observability.network
Network=llm-inference.network
NetworkAlias=prometheus
PublishPort=127.0.0.1:9090:9090
AddHost=host.containers.internal:host-gateway
Volume=%h/.local/share/llm-infra/prometheus:/prometheus:Z,U
# Der Ordner wird gemountet, nicht die einzelnen Dateien: ein Einzel-Datei-Bindung
# folgt keinem Inode-Wechsel, und `git pull` tauscht genau diese Dateien aus. Der
# Container wuerde dann weiter die alte Konfiguration lesen - stillschweigend.
Volume=@CONFIG_ROOT@/config/monitoring:/etc/prometheus/conf:ro,Z
# Fuer zusaetzliche Metriken (GPU-Zustaende, eigene Host-Kennzahlen).
Exec=--config.file=/etc/prometheus/conf/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=30d

[Service]
Restart=on-failure
RestartSec=15
# Prometheus laedt Konfiguration und Regelwerk nur auf SIGHUP neu (ein Flag wie
# --config.reload.interval existiert nicht). Nach Aenderungen an
# config/monitoring/prometheus.yml oder alerts.yml deshalb:
#   systemctl --user reload prometheus.service
ExecReload=/usr/bin/podman kill --signal HUP systemd-%N

[Install]
WantedBy=default.target
