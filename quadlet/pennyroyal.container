[Unit]
Description=Pennyroyal SGLang RTX PRO 6000 runtime
After=network-online.target
Wants=llm-inference-network.service

[Container]
Image=ghcr.io/jpezzulli/sglang-rtxpro6000:v2.5.3@sha256:c36a326dcb6a99e12ffdc89ae2f2ca0365a02fb3c72ed8b18f88d63cdc7f5a8c
ContainerName=pennyroyal
Network=llm-inference.network
PublishPort=127.0.0.1:8001:8001
AddDevice=nvidia.com/gpu=all
Volume=/srv/llm/models:/models:ro
Volume=/srv/llm/cache/pennyroyal:/cache:U,Z
Volume=/srv/llm/nixl:/nixl:U,Z
Environment=HF_HOME=/cache/huggingface
Environment=TARGET_MODEL=/models/Qwen3.8-Flash-Next-NVFP4
Environment=CACHE_BASE=/cache
Environment=NIXL_STORAGE_BASE=/nixl
Exec=next

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
